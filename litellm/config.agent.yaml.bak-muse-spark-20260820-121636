# Codex 模型路由桥接配置：Codex → LiteLLM → ChatGPT / OpenCode Go Responses。
#
# 安全约定：
# - 密钥只经环境变量 OPENCODEGO_API_KEY 注入，绝不写入本文件/日志/仓库。
# - 仅绑定 127.0.0.1；默认无 master key（本地信任模型）。
# - num_retries=0：重试所有权归调用方（Codex/daemon），LiteLLM 只转发一次。
model_list:
  # 与 Codex 模型目录一致（models.json，四模型）；Codex 按目录中的模型名发送请求。
  - model_name: opencode-go/deepseek-v4-flash
    model_info:
      mode: responses
    litellm_params:
      model: openai/deepseek-v4-flash
      api_base: https://opencode.ai/zen/go/v1
      api_key: os.environ/OPENCODEGO_API_KEY
      timeout: 60
  # OpenAI 账号路由（消耗账号余额，非 API 额度）：gpt-5.6-luna 复用
  # ~/.codex/auth.json 登录态，无需 API key。
  - model_name: gpt-5.6-luna
    model_info:
      mode: responses
    litellm_params:
      model: chatgpt/gpt-5.6-luna
      timeout: 120
  # DeepSeek 官方 API 路由（DEEPSEEK_API_KEY 经环境变量注入）；
  # Codex 按 models.json 裸名发送 deepseek-v4-flash / -pro。
  - model_name: deepseek-v4-flash
    model_info:
      mode: responses
    litellm_params:
      model: openai/deepseek-v4-flash
      api_base: https://api.deepseek.com/
      api_key: os.environ/DEEPSEEK_API_KEY
      timeout: 60
  - model_name: deepseek-v4-pro
    model_info:
      mode: responses
    litellm_params:
      model: openai/deepseek-v4-pro
      api_base: https://api.deepseek.com/
      api_key: os.environ/DEEPSEEK_API_KEY
      timeout: 60
litellm_settings:
  cache: false
  callbacks: []
  success_callback: []
  failure_callback: []
  turn_off_message_logging: true
  suppress_debug_info: true
  telemetry: false
general_settings:
  store_model_in_db: false
  cancel_on_disconnect: true
router_settings:
  num_retries: 0
